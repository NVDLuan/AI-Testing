# Copy file này thành .env rồi điền giá trị thật. .env đã được .gitignore — KHÔNG commit.
# Biến trong .env không ghi đè biến đã set sẵn ngoài shell (env thật ưu tiên hơn).

# --- API bên thứ 3 (FakeAgent) ---
API_KEY=

# --- S3 (tải video nguồn) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Tuỳ chọn: dùng nếu muốn cố định, thay cho cờ CLI ---
# AWS_DEFAULT_REGION=ap-southeast-1
# S3_ENDPOINT=

# --- File Browser (tải evidence cho report HTML) ---
# Chỉ cần khi --formats có 'html' và muốn nhúng link evidence vào báo cáo.
FILE_BROWSER_URL=
FILE_BROWSER_USER=
FILE_BROWSER_PASSWORD=

# --- Tuỳ chọn: domain/CloudFront công khai để dựng URL evidence sau khi upload S3 ---
# (bỏ trống -> tự dựng URL S3 chuẩn theo bucket/region)
# S3_PUBLIC_BASE=
