# Copy file này thành .env rồi điền giá trị thật. .env đã được .gitignore — KHÔNG commit.
# Biến trong .env không ghi đè biến đã set sẵn ngoài shell (env thật ưu tiên hơn).

# Mọi endpoint/secret dưới đây CHỈ đọc từ env (không có cờ CLI tương ứng).
# Nhiều bộ secret: tạo .env.<tenant> rồi chạy `main.py --env-file .env.<tenant>`.

# --- Google Sheet riêng tư (--source gsheet): file service account JSON ---
# Bỏ trống -> mặc định configs/service-google-sheet.json
# GSHEET_CREDENTIALS=configs/service-google-sheet.json

# --- API bên thứ 3 (FakeAgent) ---
AGENT_API=http://103.104.122.36:8000
API_KEY=

# --- S3 (DÙNG CHUNG: tải video nguồn + upload evidence) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Một bucket dùng chung cho mọi thứ (download key thuần + upload evidence).
# report_s3_bucket bỏ trống -> tự fallback về bucket này.
S3_BUCKET=
AWS_DEFAULT_REGION=ap-southeast-1
# Prefix ghép vào video_url dạng key thuần (tuỳ chọn)
# S3_PREFIX=
# Chỉ cho S3-compatible tự host (MinIO...) — AWS thật thì để trống
# S3_ENDPOINT=
# Lưu video tải về xuống đĩa + tái dùng (bỏ trống = chỉ giữ RAM)
# CACHE_DIR=video_raw

# --- Chờ AI xử lý xong ---
# Kafka watcher (linfox_vn, karter_school, bv_c)
# KAFKA_WATCHER_API_URL=
# Ngủ cố định 'H:M:S' cho tenant không dùng Kafka/Grafana (TenantFactory mặc định)
# TIME_WAITING=0:30:0

# --- File Browser (tải evidence cho report HTML) ---
# Chỉ cần khi --formats có 'html' và muốn nhúng link evidence vào báo cáo.
FILE_BROWSER_URL=
FILE_BROWSER_USER=
FILE_BROWSER_PASSWORD=

# --- Tuỳ chọn: domain/CloudFront công khai để dựng URL evidence sau khi upload S3 ---
# (bỏ trống -> tự dựng URL S3 chuẩn theo bucket/region)
# S3_PUBLIC_BASE=

# --- Grafana/Loki (WaitingGrafana — chờ AI rảnh qua log, dùng cho tenant ews_usa) ---
GRAFANA_URL=
GRAFANA_USERNAME=
GRAFANA_PASSWORD=
# Nhãn Loki: {server="<GRAFANA_SERVER_NAME>",container=~"<GRAFANA_SERVICE_NAME>"}
GRAFANA_SERVER_NAME=
GRAFANA_SERVICE_NAME=
# Chuỗi con xác nhận AI idle, phân tách dấu phẩy (rỗng -> dùng mặc định trong factory)
# GRAFANA_TARGET_LOGS=
# GRAFANA_POLL_INTERVAL_SEC=120
