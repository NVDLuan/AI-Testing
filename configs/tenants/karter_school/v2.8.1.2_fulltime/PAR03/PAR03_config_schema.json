{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "PAR03 Configuration Schema",
    "type": "object",
    "properties": {
        "utc_offset": {
            "type": "integer",
            "description": "Timezone for the camera location (e.g., '-5')",
            "ui:section": "normal",
            "default": -4
        },
        "work_days": {
            "type": "array",
            "items": {
                "type": "integer"
            },
            "ui:section": "advanced_hidden",
            "default": [0, 1, 2, 3, 4]
        },
        "work_time": {
            "type": "array",
            "items": {
                "type": "integer"
            },
            "ui:section": "advanced_hidden",
            "default": [7, 18]
        },
        "fps": {
            "type": "integer",
            "ui:section": "advanced_hidden",
            "default": 10
        },
        "cam_resolution": {
            "type": "array",
            "items": {
                "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2,
            "ui:section": "advanced_hidden",
            "default": [1280, 720]
        },
        "confidence_threshold": {
            "type": "number",
            "ui:section": "advanced_hidden",
            "default": 0.4
        },
        "event_cooldown_seconds": {
            "type": "number",
            "ui:section": "advanced_hidden",
            "default": 300
        },
        "violent_duration_threshold": {
            "type": "integer",
            "ui:section": "normal",
            "title": "Violent Duration Threshold (seconds)",
            "default": 20
        },
        "phone_usage_ratio_threshold": {
            "type": "number",
            "ui:section": "advanced_hidden",
            "default": 0.4
        },
        "min_duration": {
            "type": "integer",
            "ui:section": "advanced_hidden",
            "default": 10
        },
        "threshold_phone": {
            "type": "number",
            "ui:section": "advanced_hidden",
            "default": 0.4
        },
        "target_class": {
            "type": "array",
            "items": {"type": "string"},
            "ui:section": "advanced_hidden",
            "default": ["adult"]
        }
    },
    "required": [
        "utc_offset",
        "work_days",
        "work_time",
        "fps",
        "cam_resolution",
        "confidence_threshold",
        "event_cooldown_seconds",
        "violent_duration_threshold",
        "phone_usage_ratio_threshold",
        "min_duration",
        "threshold_phone",
        "target_class"
    ],
    "additionalProperties": true
}